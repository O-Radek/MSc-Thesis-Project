class ImProcessingWindow(QWidget): # create a new class for the image processing options window
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Image Processing Options")

        layout = QVBoxLayout()

        self.exampleOption = QCheckBox("Example Option") # create a checkbox that will show/hide the slider and spinbox when toggled

        self.exampleSlider = QSlider(Qt.Horizontal) # create a horizontal slider, which has example values from -10.0 to 10.0 with a 
        # step of 0.01, but since QSlider only accepts integers, we will multiply the values by 100 to achieve the desired range and step
        self.exampleSlider.setRange(-1000, 1000)
        self.exampleSlider.setSingleStep(1)
        self.exampleSlider.setValue(0)
        self.exampleSlider.hide()

        self.exampleInput = QDoubleSpinBox() # create a double spin box that will show/hide with the slider, and will have the same range 
        # and step as the slider, but will display the values as they are (divided by 100)
        self.exampleInput.setRange(-10.0, 10.0)
        self.exampleInput.setDecimals(2)
        self.exampleInput.setSingleStep(0.01)
        self.exampleInput.setValue(0.0)
        self.exampleInput.hide()

        self.exampleOption.toggled.connect(self.exampleSlider.setVisible) # toggles the visibility of the slider and spinbox when the checkbox is toggled
        self.exampleOption.toggled.connect(self.exampleInput.setVisible)
        self.exampleSlider.valueChanged.connect(self.slider_value) # connect the valueChanged signal of the slider to the slider_value method, which will update the value of the spinbox when the slider is moved
        self.exampleInput.valueChanged.connect(self.spinbox_value_changed) # connect the valueChanged signal of the spinbox to the spinbox_value_changed method, which will update the value of the slider when the spinbox is changed
        self.exampleSlider.sliderReleased.connect(self.slider_released) # debugging: print the value of the slider when it is released to verify that the value is being updated correctly

        layout.addWidget(self.exampleOption) # organizes the widgets in the window using a vertical layout
        layout.addWidget(self.exampleInput)
        layout.addWidget(self.exampleSlider)
        
        self.setLayout(layout) # set the layout of the window to the vertical layout we created

    def slider_value(self, value):
        self.exampleInput.blockSignals(True) # block the signals of the spinbox to prevent it from triggering the spinbox_value_changed method when we update its value
        self.exampleInput.setValue(value / 100.0) # update the value of the spinbox based on the value of the slider, dividing by 100 to get the correct range and step
        self.exampleInput.blockSignals(False) # unblock the signals of the spinbox after updating its value

    def slider_released(self):
        print(f"Slider value changed: {self.exampleSlider.value() / 100.0}") # debugging: print the value of the slider when it is released to verify that the value is being updated correctly

    def spinbox_value_changed(self, value):
        self.exampleSlider.blockSignals(True) # block the signals of the slider to prevent it from triggering the slider_value method when we update its value
        self.exampleSlider.setValue(int(value * 100)) # update the value of the slider based on the value of the spinbox, multiplying by 100 to get the correct range and step
        self.exampleSlider.blockSignals(False) # unblock the signals of the slider after updating its value
        print(f"Spinbox value changed: {value}") # debugging: print the value of the spinbox when it is changed to verify that the value is being updated correctly



